LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20

MONITORING_API_BASE_URL=http://127.0.0.1:8001
MONITORING_TIMEOUT_SECONDS=5
AGENT_CHAT_URL=http://127.0.0.1:8000/chat
AGENT_CHAT_TIMEOUT_SECONDS=65

BACKEND_PORT=8001
AGENT_PORT=8000
CORS_ORIGINS=http://localhost:5173
BACKEND_HOST=127.0.0.1
# PORT overrides BACKEND_PORT on hosting providers.
# DATABASE_PATH defaults to .local/opsguard.sqlite3 relative to the repository.
DATABASE_PATH=
# Set a strong random password before using the operator controls.
OPERATOR_PASSWORD=
# Use true for a private or deployed workspace.
PROTECT_READS=false
# Shared read-only monitoring key on the backend and agent when reads are protected.
MONITORING_API_KEY=
# WSO2 endpoint invocation key on the backend only.
AGENT_API_KEY=
# Comma-separated canonical HTTPS origins. Empty disables registration.
APPROVED_HTTPS_ORIGINS=
# JSON object mapping exact external endpoint URLs to read-only bearer tokens.
EXTERNAL_BEARER_TOKENS={}

