map $uri $cache_policy {
    default "no-store";
    ~^/assets/ "public, max-age=31536000, immutable";
}
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    resolver ${NGINX_LOCAL_RESOLVERS} ipv6=off valid=30s;
    server_tokens off;
    add_header Cache-Control $cache_policy always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;

    location = /healthz { access_log off; return 200 "ok\n"; }
    location /api/ {
        set $upstream "${BACKEND_ORIGIN}";
        proxy_pass $upstream$request_uri;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 4;
        proxy_connect_timeout 5s;
        proxy_read_timeout 75s;
        proxy_hide_header Cache-Control;
    }
    location /assets/ { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
}
